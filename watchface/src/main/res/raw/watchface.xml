<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />
    <Metadata key="STEP_GOAL" value="10000" />

    <Scene backgroundColor="#FF05070B">

        <!-- Anel Circular Externo Sutil de Acabamento Ultra -->
        <Group x="0" y="0" width="450" height="450" name="outer_bezel_ring">
            <PartDraw x="8" y="8" width="434" height="434">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Ellipse x="0" y="0" width="434" height="434">
                    <Stroke color="#FF182232" thickness="2" />
                </Ellipse>
            </PartDraw>

            <!-- Data e Dia da Semana no Topo -->
            <PartText x="105" y="16" width="240" height="22">
                <Variant mode="AMBIENT" target="alpha" value="140" />
                <Text align="CENTER" ellipsis="TRUE">
                    <Font
                        family="SYNC_TO_DEVICE"
                        size="13.0"
                        weight="BOLD"
                        color="#FFF59E0B">
                        <Template><![CDATA[%s  •  %s/%s]]>
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY_Z]" />
                            <Parameter expression="[MONTH_Z]" />
                        </Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Relógio Digital Principal (Modo Interativo e Modo Ambiente) -->
        <DigitalClock x="65" y="34" width="320" height="60">
            <TimeText
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                x="0"
                y="0"
                width="320"
                height="60"
                alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="54"
                    weight="BOLD"
                    slant="NORMAL"
                    color="#FFFFFFFF" />
            </TimeText>
            <TimeText
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                x="0"
                y="0"
                width="320"
                height="60"
                alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="54"
                    weight="THIN"
                    slant="NORMAL"
                    color="#FF94A3B8" />
            </TimeText>
        </DigitalClock>

        <!--
            SLOT 1 (TOPO - x=48, y=98, w=354, h=70):
            Exibe o Próximo Evento à esquerda, a Contagem Regressiva em pílula dourada à direita
