        -->
        <ComplicationSlot
            x="48"
            y="98"
            width="354"
            height="70"
            slotId="1"
            displayName="slot_timer_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY">

            <DefaultProviderPolicy
                primaryProvider="com.chronowear.sync/com.chronowear.wear.complication.NextEventComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="SHORT_TEXT" />

            <BoundingRoundBox
                x="0"
                y="0"
                width="354"
                height="70"
                outlinePadding="2.0"
                cornerRadius="20" />

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="354" height="70">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="354"
                        height="70"
                        cornerRadiusX="20"
                        cornerRadiusY="20">
                        <Fill color="#FF101722" />
