                <PartText x="16" y="9" width="222" height="24">
                    <Text align="START" ellipsis="TRUE">
                        <Font
                            family="SYNC_TO_DEVICE"
                            size="15.0"
                            weight="BOLD"
                            color="#FFE2E8F0">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <!-- Tempo Restante (Contagem Regressiva) dentro da pílula à direita -->
                <PartText x="248" y="9" width="86" height="24">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font
                            family="SYNC_TO_DEVICE"
                            size="15.0"
                            weight="BOLD"
                            color="#FFFBBF24">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TITLE]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <!-- Trilho e Barra de Progresso Configurável (1h / 2h antes) -->
                <PartDraw x="16" y="44" width="322" height="12">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="322"
                        height="12"
                        cornerRadiusX="6"
                        cornerRadiusY="6">
                        <Fill color="#FF1E293B" />
                    </RoundRectangle>
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="322"
                        height="12"
                        cornerRadiusX="6"
                        cornerRadiusY="6">
                        <Transform
                            target="width"
                            value="14 + 308 * (((clamp(([COMPLICATION.RANGED_VALUE_VALUE]), ([COMPLICATION.RANGED_VALUE_MIN]), ([COMPLICATION.RANGED_VALUE_MAX])) - ([COMPLICATION.RANGED_VALUE_MIN])) / (([COMPLICATION.RANGED_VALUE_MAX]) - ([COMPLICATION.RANGED_VALUE_MIN]))))" />
                        <Fill color="#FFF59E0B" />
                    </RoundRectangle>
                </PartDraw>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="354" height="70">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="354"
                        height="70"
                        cornerRadiusX="20"
                        cornerRadiusY="20">
