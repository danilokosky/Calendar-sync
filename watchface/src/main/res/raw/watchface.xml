<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />
    <Metadata key="STEP_GOAL" value="10000" />

    <Scene backgroundColor="#FF090D16">

        <!-- Relógio Digital Superior (Modo Interativo e Modo Ambiente) -->
        <DigitalClock x="45" y="26" width="360" height="64">
            <TimeText
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                x="0"
                y="0"
                width="360"
                height="64"
                alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="52"
                    weight="BOLD"
                    slant="NORMAL"
                    color="#FFF8FAFC" />
            </TimeText>
            <TimeText
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                x="0"
                y="0"
                width="360"
                height="64"
                alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="52"
                    weight="THIN"
                    slant="NORMAL"
                    color="#FF94A3B8" />
            </TimeText>
        </DigitalClock>

        <!--
            SLOT 1 (TOPO): Contagem Regressiva + Barra de Progresso Automática (1h ou 2h antes)
        -->
        <ComplicationSlot
            x="45"
            y="98"
            width="360"
            height="82"
            slotId="1"
            displayName="top_complication_label"
            supportedTypes="RANGED_VALUE SHORT_TEXT EMPTY">

            <DefaultProviderPolicy
                primaryProvider="com.chronowear.sync/com.chronowear.wear.complication.NextEventComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="SHORT_TEXT" />

            <BoundingRoundBox
                x="0"
                y="0"
                width="360"
                height="82"
                outlinePadding="2.0"
                cornerRadius="16" />

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="360" height="82">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="360"
                        height="82"
                        cornerRadiusX="16"
                        cornerRadiusY="16">
                        <Fill color="#FF111827" />
                    </RoundRectangle>
                </PartDraw>

                <PartText x="18" y="8" width="324" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font
                            family="SYNC_TO_DEVICE"
                            size="18.0"
                            weight="BOLD"
                            color="#FFF59E0B">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TITLE]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <PartDraw x="20" y="44" width="320" height="12">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="320"
                        height="12"
                        cornerRadiusX="6"
                        cornerRadiusY="6">
                        <Fill color="#FF1E293B" />
                    </RoundRectangle>
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="320"
                        height="12"
                        cornerRadiusX="6"
                        cornerRadiusY="6">
                        <Transform
                            target="width"
                            value="320 * (((clamp(([COMPLICATION.RANGED_VALUE_VALUE]), ([COMPLICATION.RANGED_VALUE_MIN]), ([COMPLICATION.RANGED_VALUE_MAX])) - ([COMPLICATION.RANGED_VALUE_MIN])) / (([COMPLICATION.RANGED_VALUE_MAX]) - ([COMPLICATION.RANGED_VALUE_MIN]))))" />
                        <Fill color="#FFF59E0B" />
                    </RoundRectangle>
                </PartDraw>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="360" height="82">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="360"
                        height="82"
                        cornerRadiusX="16"
                        cornerRadiusY="16">
                        <Fill color="#FF111827" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="18" y="24" width="324" height="34">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font
                            family="SYNC_TO_DEVICE"
                            size="18.0"
                            weight="BOLD"
                            color="#FFF8FAFC">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!--
            SLOT 2 (JANELA GRANDE CENTRAL): Exibe sempre os Próximos 3 Eventos
        -->
        <ComplicationSlot
            x="35"
            y="192"
            width="380"
            height="190"
            slotId="2"
            displayName="bottom_complication_label"
            supportedTypes="LONG_TEXT RANGED_VALUE EMPTY">

            <DefaultProviderPolicy
                primaryProvider="com.chronowear.sync/com.chronowear.wear.complication.NextEventComplicationService"
                primaryProviderType="LONG_TEXT"
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="LONG_TEXT" />

            <BoundingRoundBox
                x="0"
                y="0"
                width="380"
                height="190"
                outlinePadding="2.0"
                cornerRadius="22" />

            <Complication type="LONG_TEXT">
                <PartDraw x="0" y="0" width="380" height="190">
                    <RoundRectangle
                        x="0"
                        y="0"
                        width="380"
                        height="190"
                        cornerRadiusX="22"
                        cornerRadiusY="22">
                        <Fill color="#FF111827" />
                    </RoundRectangle>
                </PartDraw>

                <Condition>
                    <Expressions>
                        <Expression name="has_title"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="has_title">
                        <PartText x="20" y="12" width="340" height="28">
                            <Text align="START" ellipsis="TRUE">
                                <Font
                                    family="SYNC_TO_DEVICE"
                                    size="17.0"
                                    weight="BOLD"
                                    color="#FFF59E0B">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="[COMPLICATION.TITLE]" />
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="20" y="44" width="340" height="132">
                            <Text align="START" maxLines="4" ellipsis="TRUE">
                                <Font
                                    family="SYNC_TO_DEVICE"
                                    size="18.0"
                                    weight="MEDIUM"
                                    color="#FFE2E8F0">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="[COMPLICATION.TEXT]" />
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="20" y="18" width="340" height="154">
                            <Text align="START" maxLines="4" ellipsis="TRUE">
                                <Font
                                    family="SYNC_TO_DEVICE"
                                    size="18.0"
                                    weight="MEDIUM"
                                    color="#FFE2E8F0">
                                    <Template><![CDATA[%s]]>
                                        <Parameter expression="[COMPLICATION.TEXT]" />
                                    </Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
        </ComplicationSlot>

    </Scene>
</WatchFace>
