                    <RoundRectangle
                        x="1"
                        y="1"
                        width="352"
                        height="68"
                        cornerRadiusX="20"
                        cornerRadiusY="20">
                        <Stroke color="#FF243244" thickness="2" />
                    </RoundRectangle>
                    <!-- Pílula de destaque da Contagem Regressiva no canto superior direito -->
                    <RoundRectangle
                        x="244"
                        y="8"
                        width="94"
                        height="26"
                        cornerRadiusX="13"
                        cornerRadiusY="13">
                        <Fill color="#FF2B1F0C" />
                    </RoundRectangle>
