<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="com.samsung.android.app.reminder.permission.READ" />
    <uses-permission android:name="com.samsung.android.app.reminder.permission.WRITE" />
    <uses-permission android:name="com.samsung.android.providers.calendar.permission.READ_CALENDAR" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.samsung.android.app.reminder" />
        <package android:name="com.samsung.android.calendar" />
        <package android:name="com.google.android.apps.tasks" />
        <provider android:authorities="com.samsung.android.app.reminder" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_chronowear"
        android:roundIcon="@drawable/ic_launcher_chronowear"
        android:label="ChronoWear Sync"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".ui.MobileSyncConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.CalendarSyncForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".sync.WearRequestListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/request_sync_from_watch" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/pong_watch_app" />
            </intent-filter>
        </service>

        <!-- Observa notificações sobre Clima e Tarefas no telefone -->
        <service
            android:name=".sync.PhoneWeatherNotificationListenerService"
            android:exported="true"
            android:label="ChronoWear Detector de Clima e Tarefas"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Sincroniza em tempo real tarefas criadas/editadas/concluídas no Samsung Reminder, Samsung Calendar e Google Tasks -->
        <service
            android:name=".sync.ChronoWearTasksAccessibilityService"
            android:exported="true"
            android:label="ChronoWear Sincronizador de Tarefas (Reminder / Tasks)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chronowear_tasks_accessibility" />
        </service>

        <receiver
            android:name=".sync.CalendarChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" android:host="com.android.calendar" />
                <data android:scheme="content" android:host="com.samsung.android.app.reminder" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.samsung.android.app.reminder.broadcast.REMINDER_DATA_CHANGED" />
                <action android:name="com.samsung.android.app.reminder.ACTION_REMINDER_DATA_CHANGED" />
                <action android:name="com.samsung.android.calendar.ACTION_EVENT_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
