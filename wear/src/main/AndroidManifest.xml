<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Garante compilação estrita apenas para Wear OS (não híbrido), exigindo hardware de relógio -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true"
        tools:replace="android:required" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_my_calendar"
        android:label="ChronoWear Watch"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".ui.WearMainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Data Layer & Message Listener (recebe agenda e responde ao handshake de app instalado) -->
        <service
            android:name=".data.PhoneDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/calendar_horizon_payload" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/force_sync_payload" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/ping_watch_app" />
            </intent-filter>
        </service>

        <!-- SLOT 1: Temporizador Regressivo + Barra de Progresso (RANGED_VALUE) -->
        <service
            android:name=".complication.NextEventComplicationService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_my_calendar"
            android:label="ChronoWear • Temporizador &amp; Barra"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,LONG_TEXT,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <!-- SLOT 2: Compromisso #1 Individual -->
        <service
            android:name=".complication.FirstEventComplicationService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_today"
            android:label="ChronoWear • Evento #1"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <!-- SLOT 3: Compromisso #2 Individual -->
        <service
            android:name=".complication.SecondEventComplicationService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_today"
            android:label="ChronoWear • Evento #2"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <!-- SLOT 4: Compromisso #3 Individual -->
        <service
            android:name=".complication.ThirdEventComplicationService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_today"
            android:label="ChronoWear • Evento #3"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="60" />
        </service>

        <!-- Wear OS Tile para os Próximos 3 Eventos -->
        <service
            android:name=".tile.UpNextThreeEventsTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_today"
            android:label="Próximos 3 Eventos"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Receiver para transição autônoma de eventos no relógio -->
        <receiver
            android:name=".data.AutonomousTransitionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.chronowear.wear.ACTION_AUTONOMOUS_EVENT_TRANSITION" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
