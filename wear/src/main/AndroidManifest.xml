<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Garante compilação estrita apenas para Wear OS (não híbrido), exigindo hardware de relógio -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true"
        tools:replace="android:required" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_my_calendar"
        android:label="ChronoWear Watch"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".ui.WearMainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Data Layer & Message Listener (recebe agenda e responde ao handshake de app instalado) -->
        <service
            android:name=".data.PhoneDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/calendar_horizon_payload" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/force_sync_payload" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/chronowear/ping_watch_app" />
            </intent-filter>
        </service>

        <!-- COMPLICATION ÚNICA: Janela de Contexto Inteligente (Canvas Bitmap SMALL_IMAGE / PHOTO_IMAGE) -->
        <!-- O conteúdo (Eventos, Clima, Passos ou Dinâmico) é escolhido no App, sem poluir o seletor! -->
        <service
            android:name=".complication.NextEventComplicationService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_my_calendar"
            android:label="ChronoWear • Janela de Contexto (Canvas)"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,PHOTO_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Leitor de Notificações Exclusivo do Relógio (Clima, Mudança de Temperatura, Saúde) -->
        <!-- Permite que a Janela de Contexto mude dinamicamente quando chega um alerta no relógio -->
        <service
            android:name=".data.WearContextNotificationListenerService"
            android:exported="true"
            android:label="ChronoWear • Contexto por Notificações do Relógio"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Wear OS Tile para os Próximos 3 Eventos -->
        <service
            android:name=".tile.UpNextThreeEventsTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_today"
            android:label="Próximos 3 Eventos"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Receiver para transição autônoma, toque no Canvas (Tap-to-Cycle) e regra Turbo de 1 minuto -->
        <receiver
            android:name=".data.AutonomousTransitionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.chronowear.wear.ACTION_AUTONOMOUS_EVENT_TRANSITION" />
                <action android:name="com.chronowear.wear.ACTION_TAP_CYCLE_CONTEXT" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
